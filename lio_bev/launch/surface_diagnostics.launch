<launch>
  <arg name="input_topic" default="/lidar_bev/grid_map" />
  <arg name="output_prefix" default="/lidar_bev/debug" />
  <arg name="rate_hz" default="1.0" />
  <arg name="x_min" default="-15.0" />
  <arg name="x_max" default="15.0" />
  <arg name="y_min" default="-1.5" />
  <arg name="y_max" default="1.5" />
  <node pkg="lio_bev" type="surface_diagnostics.py" name="lio_bev_surface_diagnostics" output="screen">
    <env name="OPENBLAS_NUM_THREADS" value="1" />
    <env name="OMP_NUM_THREADS" value="1" />
    <param name="input_topic" value="$(arg input_topic)" />
    <param name="output_prefix" value="$(arg output_prefix)" />
    <param name="rate_hz" value="$(arg rate_hz)" />
    <param name="x_min" value="$(arg x_min)" />
    <param name="x_max" value="$(arg x_max)" />
    <param name="y_min" value="$(arg y_min)" />
    <param name="y_max" value="$(arg y_max)" />
  </node>
</launch>
